#!/usr/bin/env python3
"""Load the installed theme companion through Arch's Brave Origin wrapper."""

import os
from pathlib import Path
import shutil
import stat
import sys
import tempfile


def merge_extension_flags(contents, extension):
    """Combine load-extension flags without dropping unrelated browser options."""
    extension = str(extension)
    if any(character in extension for character in (",", "\n", "\r")):
        raise ValueError("Extension paths cannot contain commas or newlines")
    lines = contents.splitlines(keepends=True)
    extensions = []
    indexes = []
    prefix = "--load-extension="
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith(prefix):
            indexes.append(index)
            for entry in stripped[len(prefix):].split(","):
                if entry and entry not in extensions:
                    extensions.append(entry)
    if extension not in extensions:
        extensions.append(extension)
    merged = prefix + ",".join(extensions) + "\n"
    if indexes:
        first, *rest = indexes
        lines[first] = merged
        for index in reversed(rest):
            del lines[index]
    else:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append(merged)
    return "".join(lines)


def configure(config_home, data_home):
    extension = data_home / "grymm-theme-companion/extension"
    if not (extension / "manifest.json").is_file():
        raise FileNotFoundError(f"Theme companion is not installed at {extension}")
    flags = config_home / "brave-origin-flags.conf"
    # Follow a user-owned symlink rather than replacing the symlink itself.
    flags = flags.resolve()
    exists = flags.exists()
    original = flags.read_text() if exists else ""
    configured = merge_extension_flags(original, extension)
    if configured == original:
        return False
    flags.parent.mkdir(parents=True, exist_ok=True)
    backup = flags.with_name(flags.name + ".before-grymm-theme-companion")
    if exists and not backup.exists():
        shutil.copy2(flags, backup)
    mode = stat.S_IMODE(flags.stat().st_mode) if exists else 0o644
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", dir=flags.parent, prefix=f".{flags.name}.", delete=False,
        ) as output:
            temporary = Path(output.name)
            output.write(configured)
        temporary.chmod(mode)
        temporary.replace(flags)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)
    return True


def main():
    home = Path.home()
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    data = Path(os.environ.get("XDG_DATA_HOME") or home / ".local/share")
    try:
        changed = configure(config, data)
    except (OSError, ValueError) as error:
        print(f"Theme companion browser setup: {error}", file=sys.stderr)
        return 1
    print("Brave Origin theme companion loading " +
          ("configured." if changed else "already configured."))
    print("Fully exit Brave Origin and reopen it to load the extension.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
