{
  "manifest_version": 3,
  "name": "Notion Calendar → Desktop",
  "version": "1.2.0",
  "description": "Open Notion task links from Notion Calendar in Notion Desktop.",
  "minimum_chrome_version": "111",
  "permissions": ["webNavigation", "storage"],
  "host_permissions": [
    "https://calendar.notion.so/*",
    "https://calendar.notion.com/*",
    "https://app.notion.com/*",
    "https://www.notion.so/*",
    "https://notion.so/*"
  ],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://calendar.notion.com/*", "https://calendar.notion.so/*"],
      "js": ["direct.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
