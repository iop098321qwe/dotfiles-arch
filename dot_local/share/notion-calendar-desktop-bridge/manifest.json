{
  "manifest_version": 3,
  "name": "Notion Calendar → Desktop",
  "version": "1.1.0",
  "description": "Open Notion task links from Notion Calendar in Notion Desktop.",
  "minimum_chrome_version": "111",
  "permissions": ["webNavigation", "storage"],
  "host_permissions": [
    "https://calendar.notion.so/*",
    "https://app.notion.com/*",
    "https://www.notion.so/*",
    "https://notion.so/*"
  ],
  "background": { "service_worker": "background.mjs", "type": "module" }
}
