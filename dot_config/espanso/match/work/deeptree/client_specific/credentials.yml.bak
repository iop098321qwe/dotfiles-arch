# espanso match file

anchors:
  credential_output: &credential_output
    name: credentials
    type: script
    params:
      args:
        - sh
        - "%CONFIG%/scripts/credential-generator.sh"

matches:
  ################################################################################
  ################################################################################
  # TEMPLATE FOR NEW CLIENTS
  # Imaginary Domain
  - regex: ';credid(?P<firstname>[^,]+),(?P<lastname>[^.]+)\.'
    vars:
      # ==================== CLIENT SETTINGS: EDIT ONLY THESE VALUES ====================
      # Username/email-local-part format shortcuts:
      #   fn    = firstname only                    (john)
      #   ln    = lastname only                     (smith)
      #   fnln  = firstname + lastname              (johnsmith)
      #   fnli  = firstname + last initial          (johns)
      #   filn  = first initial + lastname          (jsmith)
      #   fili  = first initial + last initial      (js)
      #   fn.ln = firstname + "." + lastname        (john.smith)
      #   fn.li = firstname + "." + last initial    (john.s)
      #   fi.ln = first initial + "." + lastname    (j.smith)
      #   fi.li = first initial + "." + last initial (j.s)

      - name: username_format
        type: echo
        params:
          echo: "fn.ln"

      - name: email_domain
        type: echo
        params:
          echo: "imaginarydomain.org"

      # Leave blank to use username_format for the email local part.
      - name: email_local_format
        type: echo
        params:
          echo: ""
      # ================================================================================

      # Shared credential-generation variable; defined once in anchors above.
      - *credential_output

      # Leave unchanged.
      - name: temppass
        type: match
        params:
          trigger: ";tp"

    replace: |-
      {{credentials}}
      {{temppass}}

  ################################################################################
  ################################################################################

  # Alaska SeaLife Center
  - regex: ';credaslc(?P<firstname>[^,]+),(?P<lastname>[^.]+)\.'
    vars:
      - name: username
        type: shell
        params:
          cmd: |-
            first=$(echo "{{firstname}}")
            last=$(echo "{{lastname}}")

            first_initial=$(echo "$first" | awk '{ for (i=1; i<=NF; i++) printf tolower(substr($i,1,1)) }')
            last_initial=$(echo "$last" | awk '{ for (i=1; i<=NF; i++) printf tolower(substr($i,1,1)) }')
            first_name=$(echo "$first" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
            last_name=$(echo "$last" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

            printf "%s%s" "$first_name" "$last_initial"
      - name: fullname
        type: shell
        params:
          cmd: |-
            first=$(echo "{{firstname}}" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
            last=$(echo "{{lastname}}" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
            printf "%s %s" "$first" "$last"
      - name: email
        type: shell
        params:
          cmd: |-
            printf "%s@alaskasealife.org" "{{username}}"
      - name: temppass
        type: match
        params:
          trigger: ";tp"
    replace: |-
      {{fullname}}
      Username: {{username}}
      Email: {{email}}
      {{temppass}}

