#!/usr/bin/env bash

set -euo pipefail

# TODO(Omarchy Quattro): Remove this dispatcher after all managed hosts run v4+.
hook_runner=$(command -v omarchy-hook 2>/dev/null || true)
if [[ -n $hook_runner ]] && grep -q 'HOOK_DIR=' "$hook_runner"; then
  exit 0
fi

readonly SPICETIFY_HOOK="$HOME/.config/omarchy/hooks/theme-set.d/20-spicetify.sh"
if [[ -x "$SPICETIFY_HOOK" ]]; then
  exec "$SPICETIFY_HOOK" "$@"
fi
