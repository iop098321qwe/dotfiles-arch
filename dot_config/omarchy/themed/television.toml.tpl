# Generated by Omarchy. Customize ~/.config/omarchy/themed/television.toml.tpl.

# General
background = '{{ background }}'
border_fg = '{{ accent }}'
text_fg = '{{ foreground }}'
# Keep secondary text in the foreground's hue rather than a grey ANSI shade.
dimmed_text_fg = '{{ mix background foreground 65% }}'

# Input
input_text_fg = '{{ foreground }}'
result_count_fg = '{{ accent }}'

# Results
result_name_fg = '{{ foreground }}'
result_line_number_fg = '{{ accent }}'
result_value_fg = '{{ foreground }}'
selection_fg = '{{ selection_foreground }}'
selection_bg = '{{ selection_background }}'
match_fg = '{{ accent }}'

# Preview
preview_title_fg = '{{ accent }}'

# Modes
channel_mode_fg = '{{ background }}'
channel_mode_bg = '{{ accent }}'
remote_control_mode_fg = '{{ background }}'
remote_control_mode_bg = '{{ accent }}'
action_picker_mode_fg = '{{ background }}'
action_picker_mode_bg = '{{ accent }}'
