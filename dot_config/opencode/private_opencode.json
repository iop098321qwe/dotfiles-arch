{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "autoupdate": false,
  "permission": {
    "question": "allow"
  },
  "plugin": [
    "opencode-snippets"
  ],
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.8.0",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
      }
    }
  }
}
